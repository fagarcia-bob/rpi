{
    "name": "Raspberry Pi",

    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },

    "remoteUser": "vscode",

    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y openssh-client rsync",

    "remoteEnv": {
        "PYTHONDONTWRITEBYTECODE": "1"
    }
}